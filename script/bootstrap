#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

if [[ ${HOMEBREW_INSIDE_BUNDLE:-} != "1" ]] && command -v brew &>/dev/null; then
  export HOMEBREW_NO_AUTO_UPDATE=1
  eval "$(brew bundle --check --install env)"
fi

# Share installed gems between worktrees belonging to the same repository.
bundle config set --local path "$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")/vendor/bundle"
bundle config set --local clean false
bundle check || bundle install
